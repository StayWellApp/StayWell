rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default Deny: All access must be explicitly granted below
    match /{document=**} {
      allow read, write: if false;
    }

    // --- HELPER FUNCTIONS ---
    
    // Checks if the user is a super admin via token or user document
    function isSuperAdmin() {
      return request.auth != null && (
        request.auth.token.superAdmin == true || 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin'
      );
    }

    // Checks if the user is the owner of the document
    function isOwner(resourceData) {
      return request.auth != null && request.auth.uid == resourceData.ownerId;
    }

    // --- COLLECTION RULES ---

    // USERS: Admins see all, users see/edit themselves
    match /users/{userId} {
      allow read, write: if request.auth.uid == userId || isSuperAdmin();

      match /activity_logs/{logId} {
        allow read: if isSuperAdmin() || request.auth.uid == userId;
        allow write: if false; // Only via backend
      }
      
      match /configs/{configId} {
        allow read, write: if request.auth.uid == userId || isSuperAdmin();
      }
    }

    // CLIENTS: Fixed to allow Super Admins to manage and view clients
  match /clients/{clientId} {
      allow read, write: if request.auth != null && (
        isSuperAdmin() || 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner'
      );
    }
  
    // PROPERTIES: Owner or Admin access
    match /properties/{propertyId} {
      allow read: if isSuperAdmin() || isOwner(resource.data);
      allow write: if isOwner(resource.data) || isSuperAdmin();
    }

    // BOOKINGS
    match /bookings/{bookingId} {
      allow read, write: if isSuperAdmin() || isOwner(resource.data);
    }

    // TASKS
    match /tasks/{taskId} {
      allow read, write: if isSuperAdmin() || 
                         isOwner(resource.data) || 
                         request.auth.uid == resource.data.assignedTo;
      
      match /comments/{commentId} {
        allow read, create: if isSuperAdmin() || 
                             isOwner(get(/databases/$(database)/documents/tasks/$(taskId)).data) ||
                             request.auth.uid == get(/databases/$(database)/documents/tasks/$(taskId)).data.assignedTo;
      }
    }

    // STORAGE & INVENTORY
    match /storageLocations/{locationId} {
      allow read, write: if isSuperAdmin() || isOwner(resource.data);
      
      match /supplies/{supplyId} {
        allow read, write: if isSuperAdmin() || 
                           isOwner(get(/databases/$(database)/documents/storageLocations/$(locationId)).data);
      }
    }

    // SETTINGS & SYSTEM
    match /appSettings/{docId} { allow read, write: if isSuperAdmin(); }
    match /subscriptionPlans/{planId} { allow read, write: if isSuperAdmin(); }
    match /auditLog/{logId} { allow read: if isSuperAdmin(); }
    match /userSettings/{userId} { allow read, write: if request.auth.uid == userId || isSuperAdmin(); }
    match /customRoles/{roleId} { allow read, write: if isSuperAdmin() || isOwner(resource.data); }
    match /checklistTemplates/{templateId} { allow read, write: if isSuperAdmin() || isOwner(resource.data); }
  }
}